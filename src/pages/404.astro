---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Страница не найдена"
  description="Страница не найдена. Откройте каталог локальных инструментов Toolsiano для изображений, PDF, паролей и QR-кодов."
  noindex={true}
>
  <section class="prose">
    <div class="eyebrow">404</div>
    <h1>Здесь пока ничего нет.</h1>
    <p>Возможно, адрес изменился. Все инструменты доступны в каталоге.</p>
    <a class="button" href="/">
      Открыть инструменты
    </a>
  </section>
</Layout>
