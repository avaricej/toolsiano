---
const { pdf = false } = Astro.props;
---

<fieldset id="watermark-controls">
  <legend>Водяной знак</legend>
  <div class="field">
    <label for="wm-type">Тип водяного знака</label>
    <select id="wm-type">
      {!pdf && <option value="none">Без водяного знака</option>}
      <option value="text" selected={pdf}>
        Текст
      </option>
      <option value="image">Изображение / логотип</option>
    </select>
  </div>
  <div id="wm-text-fields" hidden={!pdf}>
    <div class="field">
      <label for="watermark">Текст водяного знака</label>
      <input id="watermark" maxlength="150" placeholder="Ваш текст" />
    </div>
    <div class="field">
      <label for="wm-color">Цвет текста</label>
      <input id="wm-color" type="color" value={pdf ? '#555555' : '#ffffff'} />
    </div>
    {pdf && (
      <>
        <label class="check-label">
          <input id="mark-date" type="checkbox" />
          Добавить текущую дату
        </label>
        <label class="check-label">
          <input id="mark-pages" type="checkbox" />
          Добавить номера страниц
        </label>
      </>
    )}
  </div>
  <div id="wm-image-fields" hidden>
    <div class="field">
      <label for="wm-file">Файл логотипа</label>
      <input id="wm-file" type="file" accept="image/png,image/jpeg,image/webp" />
      <small>
        PNG, JPEG, WebP · до 5 МБ и 2 мегапикселей. Для прозрачного фона используйте PNG.
      </small>
      <span id="wm-file-name"></span>
      <button type="button" class="button secondary" id="wm-remove">
        Убрать логотип
      </button>
    </div>
  </div>
  <div id="wm-settings" hidden={!pdf}>
    <div class="field-row">
      <div class="field">
        <label for="wm-size">Ширина знака, %</label>
        <input id="wm-size" type="number" min="5" max="90" value="30" />
      </div>
      <div class="field">
        <label for="wm-opacity">Непрозрачность, %</label>
        <input id="wm-opacity" type="number" min="5" max="100" value={pdf ? '20' : '70'} />
      </div>
    </div>
    <div class="field">
      <label for="wm-position">Положение знака</label>
      <select id="wm-position">
        <option value="0-0">Сверху слева</option>
        <option value="1-0">Сверху по центру</option>
        <option value="2-0">Сверху справа</option>
        <option value="0-1">По центру слева</option>
        <option value="1-1" selected={pdf}>
          По центру
        </option>
        <option value="2-1">По центру справа</option>
        <option value="0-2">Снизу слева</option>
        <option value="1-2">Снизу по центру</option>
        <option value="2-2" selected={!pdf}>
          Снизу справа
        </option>
      </select>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="wm-margin">Отступ от края, %</label>
        <input id="wm-margin" type="number" min="0" max="20" value="3" />
      </div>
      <div class="field">
        <label for="wm-angle">Поворот знака, °</label>
        <input id="wm-angle" type="number" min="-180" max="180" value="0" />
      </div>
    </div>
    <label class="check-label">
      <input id="wm-repeat" type="checkbox" />
      Повторять по всей площади
    </label>
  </div>
  <p class="note">Логотип хранится только в памяти этой вкладки и не отправляется на сервер.</p>
</fieldset>
