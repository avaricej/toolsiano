{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Save only files selected in a native save dialog. No general filesystem read, shell or network permissions.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "mailto:to@bxstudio.ru" }]
    }
  ]
}
